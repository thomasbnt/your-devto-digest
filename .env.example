# dev.to: Settings > Extensions > "DEV Community API Keys"
DEVTO_API_KEY=

# LLM used for the one-line "why this matters" summaries.
# Defaults to Mistral (mistral-small-latest). MISTRAL_API_KEY is accepted as an alias.
LLM_API_KEY=
# Optional overrides (take precedence over config.json):
# LLM_MODEL=mistral-small-latest
# LLM_BASE_URL=https://api.mistral.ai/v1

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="devto-digest <you@example.com>"
MAIL_TO=you@example.com

# Optional
# DRY_RUN=1          # no email, writes .preview/preview.html (git-ignored, test only)
# CONFIG_PATH=./config.json
# STATE_PATH=./state.json
